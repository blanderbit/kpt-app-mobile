# RevenueCat API Keys
# Скопируйте этот файл в .env и заполните реальными ключами

# Production (App Store / Play Store)
REVENUECAT_IOS_API_KEY=your_ios_api_key_here
REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Test Store (dev): один ключ, продукты/цены из RevenueCat без апрува в App Store.
# Если задан — используется вместо платформенных ключей. В release НЕ использовать!
REVENUECAT_TEST_STORE_API_KEY=
